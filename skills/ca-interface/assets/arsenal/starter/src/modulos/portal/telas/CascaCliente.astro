---
// CascaCliente (5.12): a casca do portal. Logo no topo e a pílula de navegação embaixo (NavCliente, liquid-glass-navbar).
// Herda a estética do site (CLI-42): o mesmo preset, as mesmas fontes, o mesmo BannerSobreposto e a densidade
// confortável (data-densidade no contêiner). Usa o Base do app: barra F (simular a outra ponta), avisos e aparência.
// Sem Ctrl K, sem lateral e sem sino: o portal é do cliente. A conta no topo (ContaCliente) mostra a cliente da sessão
// (src/proto/cliente.ts; a barra F troca em "Ver como cliente…").
import Base from "@/layouts/Base.astro";
import NavCliente from "./NavCliente";
import { MARCA } from "@/proto/marca";
import { rotaAtual, url } from "@/lib/url";
import ContaCliente from "./ContaCliente";

interface Props { titulo: string }
const { titulo } = Astro.props;
const rota = rotaAtual(Astro.url.pathname);
---
<Base titulo={titulo}>
  <div data-densidade="confortavel" data-portal class="min-h-dvh">
    <header class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 md:px-6">
      <a href={url("portal/")} class="inline-flex min-h-10 items-center gap-2.5 rounded-lg font-display text-base font-semibold tracking-tight outline-none focus-visible:ring-2 focus-visible:ring-ring">
        <span class="size-7 text-primary [&>svg]:size-full" aria-hidden="true" set:html={MARCA.logo} />
        {MARCA.nome}
      </a>
      <nav aria-label="Conta" class="ml-auto flex items-center gap-1">
        <a href={url("site/")} class="hidden min-h-10 items-center rounded-full px-3 text-sm text-muted-foreground hover:bg-muted hover:text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring sm:inline-flex">Ver o site</a>
        <ContaCliente client:idle transition:persist="conta-cliente" />
      </nav>
    </header>
    <main id="conteudo" tabindex="-1" transition:name="conteudo" class="mx-auto max-w-6xl pb-[calc(6.5rem+env(safe-area-inset-bottom))] outline-none">
      <slot />
    </main>
    <NavCliente client:idle rota={rota} transition:persist="nav-cliente" />
  </div>
</Base>
